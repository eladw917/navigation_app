# HeiGIT / openrouteservice (required)
HEIGIT_API_KEY=replace_with_your_key
# If the HeiGIT key is missing/disallowed, the API falls back to:
# - Nominatim (OSM) for geocoding
# - circular walking approximation for isochrones
HEIGIT_ORS_BASE_URL=https://api.heigit.org/openrouteservice
HEIGIT_PELIAS_BASE_URL=https://api.heigit.org/pelias/v1

# Database
DATABASE_URL=postgres://localhost:5432/navigation

# API
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# Planner defaults
DEFAULT_WALKING_SECONDS=900
MAX_WALKING_SECONDS=1800
ENDPOINT_RADIUS_METERS=500
PLAN_RESULT_LIMIT=200
ALLOWED_ROUTE_TYPES=3

# GTFS
GTFS_SOURCE_URL=https://gtfs.mot.gov.il/gtfsfiles/israel-public-transportation.zip
